# Copier ce fichier en .env (jamais commité) et remplir les valeurs réelles.

# ── Django ────────────────────────────────────────────────────────────────
SECRET_KEY=change-moi-avec-une-cle-secrete-longue-et-aleatoire
DEBUG=False
ALLOWED_HOSTS=votredomaine.com,www.votredomaine.com

# ── Base de données ──────────────────────────────────────────────────────
# En local/Docker Compose, laisser DB_* et DATABASE_URL tel quel.
# En production (Railway, Render, etc.), DATABASE_URL est généralement
# fourni automatiquement par l'hébergeur — pas besoin de DB_*.
DB_NAME=extincteur
DB_USER=postgres
DB_PASSWORD=change-moi
DATABASE_URL=postgres://postgres:change-moi@db:5432/extincteur

# ── Celery / Redis ───────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Courriels transactionnels (Resend) ──────────────────────────────────
# Clé API à générer sur https://resend.com pour le domaine extincteursnationex.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Extincteurs Nationex <info@extincteursnationex.com>
DEFAULT_FROM_EMAIL=Extincteurs Nationex <info@extincteursnationex.com>

# ── URL publique du frontend (liens + logo dans les courriels) ──────────
FRONTEND_URL=https://votredomaine.com

# Adresse qui reçoit les messages du formulaire de contact public.
# ATTENTION : cette adresse doit avoir une vraie boîte mail (MX configurés,
# ex. Google Workspace, Zoho Mail, ou redirection ImprovMX) — Resend ne fait
# qu'envoyer, il ne fournit pas de boîte de réception.
CONTACT_EMAIL=info@extincteursnationex.com

# ── CORS / CSRF (à décommenter et adapter dans settings.py une fois le
# domaine de production connu) ───────────────────────────────────────────
# CORS_ALLOWED_ORIGINS=https://votredomaine.com
# CSRF_TRUSTED_ORIGINS=https://votredomaine.com
